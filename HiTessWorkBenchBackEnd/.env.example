# === DB 접속 정보 ===
DB_USER=admin
DB_PASSWORD=비밀번호입력
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hitessworkbench

# === AI 설정 (선택, Ollama 사용 시) ===
# AI 학습 문서 폴더 경로 (PDF/DOCX/TXT)
REPORTS_DIR=C:\경로\reports_data
# Ollama 서버 주소 (같은 서버면 기본값 사용)
OLLAMA_BASE_URL=http://localhost:11434

# === Tesseract OCR (선택, 이미지 PDF 처리 시) ===
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# === 클라이언트 배포 (선택, 기본값: 백엔드 폴더 내 LastestVersionProgram) ===
# LATEST_CLIENT_DIR=C:\경로\LastestVersionProgram

# === HiTESS 소개자료 (선택, 기본값: app/static/presentations) ===
# 이 디렉터리 안의 고정 파일명 hitess-launch-deck.html을 제공합니다.
# INTRO_PRESENTATION_DIR=C:\KHM\HiTessWorkbench\deployed-assets\presentations

# === Hi-TESS LogBook 연동(18·19) — 서버 간 공유 비밀키·주소 ===
# LogBook backend\.env 의 LOGBOOK_WB_INTEGRATION_SECRET 과 같은 값(키 이름이 다르다). 비우면 연동 전체가 꺼진다(404).
# 실제 값은 이 파일에 적지 않는다 — 145 .env 에만.
# LOGBOOK_INTEGRATION_SECRET=
# LOGBOOK_BASE_URL=http://<LogBook 서버>:<포트>

# === Hi-TESS LogBook 보내기 — 해석 여권 함께 보내기 (Hi-TESS Core 1단계, 선택) ===
# 켜면 All Projects → LogBook 보내기 때 해석 여권(검증된 산출물 이름·sha256)을 origin 에 싣는다.
# 비우면 지금과 같다. LogBook 을 먼저 배포한 뒤 켠다(hitess-core docs/10-phase1-provenance.md).
# LOGBOOK_SEND_PASSPORT=1

# === 사내 AD 로그인 (선택, 2026-11-04) ===
# ad 로 두면 /api/login 이 사번 + 회사 PC(AD) 비밀번호를 요구한다. 비우면 예전처럼 사번만.
# ⚠ 켜기 전에: 새 WorkBench exe 배포(비밀번호 칸) + AM 연동(HiTessMB·AmLauncher) 수정 + pip install -r requirements.txt.
# AUTH_MODE=ad
# 아래는 기본값이 사내 AD 라 보통 비워 둔다.
# AD_LDAP_HOST=HHIWVRA06.HHI.co.kr
# AD_LDAP_PORT=636
# AD_NETBIOS_DOMAIN=HHI
# 사내 AD 인증서가 RSA 1024 비트라 1. IT 가 키를 늘리면 2 로.
# AD_LDAP_TLS_SECLEVEL=1
# 회사 PC 계정 자동 로그인(Windows 통합 인증, 2026-11-05) — AUTH_MODE=ad 이면 저절로 켜진다(pywin32 필요).
# 비밀번호를 망에 보내지 않는다. 문제가 생기면 0 으로 꺼서 비밀번호 로그인만 남긴다(재시작 필요).
# AD_WINDOWS_LOGIN=0

# === HTTPS 병행 수신 (선택, 2026-11-05) ===
# 넣으면 같은 프로세스에서 9091(HTTP) 옆에 HTTPS 포트를 하나 더 연다. 비우면 HTTP 만(지금과 같다).
# 인증서는 이 서버에서 `python scripts/make_tls_cert.py` 로 만든다(기본 .secrets/tls/, git 제외).
# 인증서가 없거나 포트가 쓰이고 있으면 HTTPS 만 건너뛰고 9091 은 그대로 동작한다(로그에 [https] 사유).
# HTTPS_PORT=9443
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# === 이중관 PSA 소스 직접 실행 모드 (선택, 2026-10-26) ===
# 엔진 의존성(numpy·scipy·openpyxl·matplotlib·pyNastran, Python 3.8)이 설치된 python.exe 경로.
# 두면 exe 대신 엔진 폴더 .py 를 직접 실행한다(엔진 .py 수정이 다음 해석부터 반영, 재시작 불필요).
# 지우면 PSA_AllLoadCases.exe 로 돌아간다. 바꾼 뒤에는 백엔드 재시작.
# DOUBLEPIPE_PSA_PYTHON=C:\Python38\python.exe
