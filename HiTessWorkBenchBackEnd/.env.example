# === DB 접속 정보 ===
DB_USER=admin
DB_PASSWORD=비밀번호입력
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hitessworkbench

# === AI 설정 (선택, Ollama 사용 시) ===
# AI 학습 문서 폴더 경로 (PDF/DOCX/TXT)
REPORTS_DIR=C:\경로\reports_data
# Ollama 서버 주소 (같은 서버면 기본값 사용)
OLLAMA_BASE_URL=http://localhost:11434

# === Tesseract OCR (선택, 이미지 PDF 처리 시) ===
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# === 클라이언트 배포 (선택, 기본값: 백엔드 폴더 내 LastestVersionProgram) ===
# LATEST_CLIENT_DIR=C:\경로\LastestVersionProgram

# === HiTESS 소개자료 (선택, 기본값: app/static/presentations) ===
# 이 디렉터리 안의 고정 파일명 hitess-launch-deck.html을 제공합니다.
# INTRO_PRESENTATION_DIR=C:\KHM\HiTessWorkbench\deployed-assets\presentations

# === Hi-TESS LogBook 연동(18·19) — 서버 간 공유 비밀키·주소 ===
# LogBook backend\.env 의 LOGBOOK_WB_INTEGRATION_SECRET 과 같은 값(키 이름이 다르다). 비우면 연동 전체가 꺼진다(404).
# 실제 값은 이 파일에 적지 않는다 — 145 .env 에만.
# LOGBOOK_INTEGRATION_SECRET=
# LOGBOOK_BASE_URL=http://<LogBook 서버>:<포트>

# === Hi-TESS LogBook 보내기 — 해석 여권 함께 보내기 (Hi-TESS Core 1단계, 선택) ===
# 켜면 All Projects → LogBook 보내기 때 해석 여권(검증된 산출물 이름·sha256)을 origin 에 싣는다.
# 비우면 지금과 같다. LogBook 을 먼저 배포한 뒤 켠다(hitess-core docs/10-phase1-provenance.md).
# LOGBOOK_SEND_PASSPORT=1
